# ============================================================
# SENTINELA OSIRIS — variables de entorno (todas opcionales)
# ============================================================

# --- IA (DeepSeek) ---
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com/chat/completions

# --- AIS real (AISStream.io, gratuito) ---
# https://aisstream.io/  → registrarse y obtener API key
AISSTREAM_KEY=

# --- Receptor AIS propio (RTL-SDR + AIS-catcher/rtl-ais) ---
# 0 = desactivado. Ej.: 10110 (UDP NMEA)
# AIS_CATCHER_PORT=10110

# --- Servidor local ---
# HOST=127.0.0.1
# PORT=5023

# NOTA: alternativamente, puedes configurar las claves desde el panel web
# (botón ⚙ Ajustes). Se guardan en sentinela_config.json (chmod 600) o en
# variables de entorno. El archivo sentinela_config.json NUNCA debe subirse.
